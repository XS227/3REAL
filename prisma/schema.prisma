// ─────────────────────────────────────────────────────────────────────────────
// 3REAL — Prisma Schema
// Phase 2: Full Database Schema
// PostgreSQL 14 · Prisma 7 · Double-Entry Ledger Architecture
// ─────────────────────────────────────────────────────────────────────────────
//
// Design rules (non-negotiable):
//   1. No balance columns on users — ever.
//   2. All balances derived by summing ledger_entries.
//   3. Every financial event creates ≥2 ledger entries that sum to zero.
//   4. ledger_entries are immutable — no UPDATE, no DELETE.
//   5. All financial tables carry ecosystem_id.
//   6. Debit = negative amount, Credit = positive amount.
//
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  user
  operator
  super_admin
}

enum AssetCode {
  REAL
  USDT
  TON
  EUR
  NOK
  TRY
}

enum Network {
  ton
  trc20
  erc20
  real_chain
  bank
  sepa
}

enum OwnerType {
  user
  platform
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

// Types of settlement events recorded in the ledger
enum LedgerTransactionType {
  deposit
  withdrawal
  fiat_deposit
  referral_reward
  fee
  transfer
  blockchain_deposit
  blockchain_withdrawal
  correction
  initial_credit
  conversion
  pool_topup
  withdrawal_settlement
  withdrawal_reversal
}

enum LedgerTransactionStatus {
  pending
  processing
  completed
  rejected
  reversed
}

// User-submitted deposit / withdrawal requests (pre-settlement)
enum TransactionType {
  deposit
  withdrawal
}

enum TransactionStatus {
  pending
  under_review
  approved
  processing
  completed
  rejected
  cancelled
  failed
}

enum PaymentMethod {
  bank_transfer
  usdt_trc20
  ton
  sepa
  manual
}

enum ReferralStatus {
  pending
  registered
  rewarded
  invalidated
}

enum KycStatus {
  pending
  under_review
  approved
  rejected
  update_requested
}

enum KycDocType {
  id_front
  id_back
  selfie
  address_proof
  bank_statement
}

enum KycDocStatus {
  pending
  approved
  rejected
}

enum AuthTokenType {
  email_verify
  password_reset
  refresh_token
}

enum FeeDirection {
  deposit
  withdrawal
  conversion
}

enum FeeType {
  flat
  percent
  flat_percent
}

enum ExchangeRateSource {
  manual
  oracle
  admin
}

enum NotificationType {
  kyc_submitted
  kyc_approved
  kyc_rejected
  kyc_update_requested
  deposit_received
  deposit_approved
  deposit_rejected
  withdrawal_approved
  withdrawal_rejected
  withdrawal_processing
  withdrawal_failed
  referral_reward
  pool_depleted
  system
}

enum NotificationChannel {
  in_app
  email
  push
}

enum DeliveryStatus {
  pending
  sent
  failed
}

enum WithdrawalDestType {
  crypto
  bank_transfer
  sepa
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

// 1 ─ ECOSYSTEM
// Defines each product in the SETAEI ecosystem.
// All financial tables carry ecosystem_id for full isolation + cross-product queries.
model Ecosystem {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)  // 'three_real', 'shahnameh', 'trust_ai', 'setaei_pay'
  name      String   @db.VarChar(128)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  accounts           Account[]
  ledgerTransactions LedgerTransaction[]
  ledgerEntries      LedgerEntry[]
  transactions       Transaction[]
  referrals          Referral[]
  notifications      Notification[]
  settings           Setting[]
  feeTiers           FeeTier[]
  depositAddresses   DepositAddress[]
  activityLogs       ActivityLog[]

  @@map("ecosystems")
}

// 2 ─ USER
// Platform accounts. No balance fields — ever.
// Balances are always computed from ledger_entries.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(255)
  role          UserRole  @default(user)
  kycTier       Int       @default(0) @db.SmallInt  // 0=none 1=email 2=id 3=full
  referralCode  String    @unique @db.VarChar(16)
  referredById  String?   @db.Uuid
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  displayName   String?   @db.VarChar(128)
  locale        String    @default("en") @db.VarChar(8)
  avatarPath    String?   @db.VarChar(512)
  twoFaEnabled  Boolean   @default(false)
  twoFaSecret   String?   @db.VarChar(128)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Self-referential: who referred this user
  referredByUser  User?  @relation("UserReferrals", fields: [referredById], references: [id])
  directReferrals User[] @relation("UserReferrals")

  authTokens             AuthToken[]
  kycProfile             KycProfile?
  transactions           Transaction[]
  referralsMade          Referral[]             @relation("ReferrerUser")
  referralsReceived      Referral[]             @relation("ReferredUser")
  notifications          Notification[]
  withdrawalDestinations WithdrawalDestination[]
  depositAddresses       DepositAddress[]
  activityLogs           ActivityLog[]          @relation("ActorLogs")
  initiatedLedgerTxs     LedgerTransaction[]    @relation("LedgerTxInitiator")
  approvedLedgerTxs      LedgerTransaction[]    @relation("LedgerTxApprover")
  reviewedKycProfiles    KycProfile[]           @relation("KycProfileReviewer")
  reviewedKycDocs        KycDocument[]          @relation("KycDocumentReviewer")
  updatedSettings        Setting[]              @relation("SettingUpdater")
  setExchangeRates       ExchangeRate[]         @relation("ExchangeRateSetter")

  @@index([email])
  @@index([referralCode])
  @@index([referredById])
  @@index([role])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

// 3 ─ ACCOUNT
// Chart of accounts for the platform.
// One record per (owner × asset × ecosystem).
// owner_type = 'user'     → owner_id = user UUID
// owner_type = 'platform' → owner_id = slug (e.g., 'float', 'rewards-pool', 'fees')
// No direct FK to users — accounts are identified by (ownerType, ownerId) for
// both user and platform accounts without splitting the table.
model Account {
  id          String      @id @default(uuid()) @db.Uuid
  ecosystemId String      @db.Uuid
  ownerType   OwnerType
  ownerId     String      @db.VarChar(255)  // user UUID or platform slug
  accountType AccountType
  assetCode   AssetCode
  label       String?     @db.VarChar(255)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  ecosystem     Ecosystem    @relation(fields: [ecosystemId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([ecosystemId, ownerType, ownerId, assetCode])
  @@index([ownerType, ownerId])
  @@index([ecosystemId])
  @@index([assetCode])
  @@map("accounts")
}

// 4 ─ LEDGER TRANSACTION
// Groups related ledger entries into one logical financial event.
// Every financial event (deposit approval, referral reward, conversion) creates one of these.
// Linked back to user requests via referenceId + referenceType (polymorphic).
model LedgerTransaction {
  id            String                  @id @default(uuid()) @db.Uuid
  ecosystemId   String                  @db.Uuid
  type          LedgerTransactionType
  status        LedgerTransactionStatus @default(completed)
  referenceId   String?                 @db.Uuid     // FK to transactions.id, referrals.id, etc.
  referenceType String?                 @db.VarChar(64)  // 'deposit_request', 'referral', etc.
  chainTxHash   String?                 @unique @db.VarChar(128)  // unique = idempotency guard
  chainNetwork  Network?
  initiatedById String?                 @db.Uuid
  approvedById  String?                 @db.Uuid
  note          String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  ecosystem   Ecosystem    @relation(fields: [ecosystemId], references: [id])
  initiatedBy User?        @relation("LedgerTxInitiator", fields: [initiatedById], references: [id])
  approvedBy  User?        @relation("LedgerTxApprover", fields: [approvedById], references: [id])
  entries     LedgerEntry[]
  // Reverse relations from tables that FK to this
  depositTxs  Transaction[]
  referralRewards Referral[]

  @@index([ecosystemId])
  @@index([referenceId, referenceType])
  @@index([type, status])
  @@index([initiatedById])
  @@index([createdAt(sort: Desc)])
  @@map("ledger_transactions")
}

// 5 ─ LEDGER ENTRY
// Immutable. The atomic double-entry records.
// Sum of amounts per ledger_transaction_id must always equal zero.
// Debit = negative, Credit = positive.
// NEVER update or delete rows in this table.
model LedgerEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  ledgerTransactionId String   @db.Uuid
  ecosystemId         String   @db.Uuid
  accountId           String   @db.Uuid
  assetCode           AssetCode
  amount              Decimal  @db.Decimal(28, 8)  // negative=debit, positive=credit
  runningBalance      Decimal? @db.Decimal(28, 8)  // optional snapshot for fast balance reads
  createdAt           DateTime @default(now())

  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  ecosystem         Ecosystem         @relation(fields: [ecosystemId], references: [id])
  account           Account           @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([ecosystemId])
  @@index([assetCode])
  @@index([ledgerTransactionId])
  @@index([createdAt(sort: Desc)])
  @@map("ledger_entries")
}

// 6 ─ TRANSACTION
// Deposit and withdrawal requests submitted by users.
// Drives the admin approval workflow.
// A ledger_transaction is only created AFTER admin approval — never before.
model Transaction {
  id            String            @id @default(uuid()) @db.Uuid
  ecosystemId   String            @db.Uuid
  userId        String            @db.Uuid
  type          TransactionType
  assetCode     AssetCode
  amount        Decimal           @db.Decimal(28, 8)
  feeAmount     Decimal           @default(0) @db.Decimal(28, 8)
  netAmount     Decimal?          @db.Decimal(28, 8)   // computed: amount - feeAmount
  status        TransactionStatus @default(pending)
  ledgerTxId    String?           @db.Uuid
  paymentMethod PaymentMethod?
  paymentRef    String?           @db.VarChar(255)
  adminNote     String?           @db.Text
  chainTxHash   String?           @db.VarChar(128)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  ecosystem Ecosystem          @relation(fields: [ecosystemId], references: [id])
  user      User               @relation(fields: [userId], references: [id])
  ledgerTx  LedgerTransaction? @relation(fields: [ledgerTxId], references: [id])

  @@index([userId])
  @@index([ecosystemId])
  @@index([status, type])
  @@index([status, type, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("transactions")
}

// 7 ─ REFERRAL
// Tracks the full lifecycle of a referral: click → registration → reward.
// Supports 2-tier commissions via referralLevel + parentReferralId.
model Referral {
  id               String         @id @default(uuid()) @db.Uuid
  ecosystemId      String         @db.Uuid
  referrerId       String         @db.Uuid
  referredId       String?        @db.Uuid
  code             String         @db.VarChar(16)
  referralLevel    Int            @default(1) @db.SmallInt  // 1=direct, 2=indirect
  parentReferralId String?        @db.Uuid  // links level-2 reward to the level-1 referral
  clickIp          String?        @db.VarChar(64)
  clickAt          DateTime?
  registeredAt     DateTime?
  rewardAmount     Decimal        @default(0) @db.Decimal(28, 8)
  ledgerTxId       String?        @db.Uuid
  status           ReferralStatus @default(pending)
  createdAt        DateTime       @default(now())

  ecosystem      Ecosystem          @relation(fields: [ecosystemId], references: [id])
  referrer       User               @relation("ReferrerUser", fields: [referrerId], references: [id])
  referred       User?              @relation("ReferredUser", fields: [referredId], references: [id])
  ledgerTx       LedgerTransaction? @relation(fields: [ledgerTxId], references: [id])
  parentReferral Referral?          @relation("ReferralChain", fields: [parentReferralId], references: [id])
  childReferrals Referral[]         @relation("ReferralChain")

  @@index([referrerId, status])
  @@index([referredId])
  @@index([code])
  @@index([referralLevel, parentReferralId])
  @@map("referrals")
}

// 8 ─ KYC PROFILE
// One KYC profile per user. Tracks the overall KYC state.
// Individual documents are managed in kyc_documents for per-document review.
model KycProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  tierRequested   Int       @db.SmallInt
  status          KycStatus @default(pending)
  rejectionReason String?   @db.Text
  reviewedById    String?   @db.Uuid
  reviewedAt      DateTime?
  submittedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  reviewedBy User?         @relation("KycProfileReviewer", fields: [reviewedById], references: [id])
  documents  KycDocument[]

  @@index([status])
  @@index([userId])
  @@index([submittedAt(sort: Asc)])  // admin queue: oldest first
  @@map("kyc_profiles")
}

// 9 ─ KYC DOCUMENT (new in Phase 1.5 review)
// Per-document management replaces flat path fields on kyc_profiles.
// Enables admin to reject specific documents without voiding the entire KYC submission.
// Tracks revision history via the version field.
model KycDocument {
  id              String       @id @default(uuid()) @db.Uuid
  kycProfileId    String       @db.Uuid
  docType         KycDocType
  filePath        String       @db.VarChar(512)
  fileName        String?      @db.VarChar(255)
  fileSizeBytes   Int?
  mimeType        String?      @db.VarChar(64)
  status          KycDocStatus @default(pending)
  rejectionReason String?      @db.Text
  reviewedById    String?      @db.Uuid
  reviewedAt      DateTime?
  version         Int          @default(1) @db.SmallInt  // increments on re-upload
  createdAt       DateTime     @default(now())

  kycProfile KycProfile @relation(fields: [kycProfileId], references: [id])
  reviewedBy User?      @relation("KycDocumentReviewer", fields: [reviewedById], references: [id])

  @@index([kycProfileId, docType])
  @@index([status])
  @@map("kyc_documents")
}

// 10 ─ ACTIVITY LOG
// Immutable audit trail. Every admin action and financial event is recorded here.
// target_type + target_id is a polymorphic reference — no FK constraint by design.
model ActivityLog {
  id          String    @id @default(uuid()) @db.Uuid
  ecosystemId String?   @db.Uuid
  actorId     String?   @db.Uuid  // who performed the action (null = system)
  targetId    String?   @db.Uuid  // affected record
  targetType  String?   @db.VarChar(64)  // 'user', 'kyc_profile', 'transaction', etc.
  action      String    @db.VarChar(128) // 'kyc.approve', 'transaction.reject', etc.
  meta        Json?
  ipAddress   String?   @db.VarChar(64)
  userAgent   String?   @db.Text
  createdAt   DateTime  @default(now())

  ecosystem Ecosystem? @relation(fields: [ecosystemId], references: [id])
  actor     User?      @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetId, targetType])
  @@index([ecosystemId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

// 11 ─ NOTIFICATION
// In-app and email notifications per user.
// channel + deliveryStatus enable multi-channel delivery tracking.
model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  ecosystemId    String?             @db.Uuid
  type           NotificationType
  title          String              @db.VarChar(255)
  body           String?             @db.Text
  isRead         Boolean             @default(false)
  referenceId    String?             @db.Uuid
  referenceType  String?             @db.VarChar(64)
  channel        NotificationChannel @default(in_app)
  sentAt         DateTime?
  deliveryStatus DeliveryStatus      @default(pending)
  createdAt      DateTime            @default(now())

  user      User       @relation(fields: [userId], references: [id])
  ecosystem Ecosystem? @relation(fields: [ecosystemId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([deliveryStatus])
  @@map("notifications")
}

// 12 ─ SETTING
// Platform-level key/value configuration store.
// ecosystemId = null means global setting; non-null means ecosystem-specific.
model Setting {
  id          String    @id @default(uuid()) @db.Uuid
  ecosystemId String?   @db.Uuid
  key         String    @db.VarChar(255)
  value       String    @db.Text
  type        String    @default("string") @db.VarChar(32)  // 'string', 'number', 'boolean', 'json'
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ecosystem Ecosystem? @relation(fields: [ecosystemId], references: [id])
  updatedBy User?      @relation("SettingUpdater", fields: [updatedById], references: [id])

  @@unique([ecosystemId, key])
  @@index([ecosystemId])
  @@map("settings")
}

// 13 ─ AUTH TOKEN (new in Phase 1.5 review)
// Server-side token store for email verification, password reset, and JWT refresh rotation.
// Only the hash is stored — the raw token is sent to the user and never persisted.
model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  tokenHash  String        @unique @db.VarChar(128)  // SHA-256 hash of the raw token
  type       AuthTokenType
  expiresAt  DateTime
  usedAt     DateTime?
  ipAddress  String?       @db.VarChar(64)
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// 14 ─ FEE TIER (new in Phase 1.5 review)
// Structured fee schedule per (ecosystem × kyc_tier × asset × direction).
// Replaces ad-hoc settings keys — enables per-asset, per-tier fee rules queryable by DB.
// kycTier = 0 means "applies to all tiers" (lowest-specificity default).
model FeeTier {
  id             String       @id @default(uuid()) @db.Uuid
  ecosystemId    String       @db.Uuid
  kycTier        Int          @default(0) @db.SmallInt  // 0=any, 1/2/3=specific tier
  assetCode      AssetCode
  direction      FeeDirection
  feeType        FeeType
  flatAmount     Decimal      @default(0) @db.Decimal(28, 8)
  percentAmount  Decimal      @default(0) @db.Decimal(8, 4)  // e.g. 1.5000 = 1.5%
  minFee         Decimal      @default(0) @db.Decimal(28, 8)
  maxFee         Decimal?     @db.Decimal(28, 8)  // null = no cap
  minTransaction Decimal      @default(0) @db.Decimal(28, 8)
  maxTransaction Decimal?     @db.Decimal(28, 8)  // null = no cap
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  ecosystem Ecosystem @relation(fields: [ecosystemId], references: [id])

  @@unique([ecosystemId, kycTier, assetCode, direction])
  @@index([ecosystemId, assetCode, direction, kycTier])
  @@map("fee_tiers")
}

// 15 ─ EXCHANGE RATE (new in Phase 1.5 review)
// Stores current and historical rates for all asset pairs.
// Provides audit trail of "what rate was applied when" for every conversion.
// Current rate: WHERE valid_until IS NULL ORDER BY valid_from DESC LIMIT 1
model ExchangeRate {
  id         String             @id @default(uuid()) @db.Uuid
  fromAsset  AssetCode
  toAsset    AssetCode
  rate       Decimal            @db.Decimal(28, 8)  // 1 fromAsset = rate toAsset
  source     ExchangeRateSource @default(manual)
  setById    String?            @db.Uuid
  validFrom  DateTime           @default(now())
  validUntil DateTime?          // null = currently active
  createdAt  DateTime           @default(now())

  setBy User? @relation("ExchangeRateSetter", fields: [setById], references: [id])

  @@index([fromAsset, toAsset, validFrom(sort: Desc)])
  @@index([validUntil])
  @@map("exchange_rates")
}

// 16 ─ DEPOSIT ADDRESS (new in Phase 1.5 review)
// Per-user custodial deposit addresses for blockchain networks.
// Empty in v1. Populated in v2 when blockchain deposits go live.
// Unique per (user × ecosystem × network) — one address per user per chain.
model DepositAddress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  ecosystemId    String    @db.Uuid
  network        Network
  address        String    @unique @db.VarChar(255)
  derivationPath String?   @db.VarChar(128)  // BIP-44 HD wallet path
  label          String?   @db.VarChar(128)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
  ecosystem Ecosystem @relation(fields: [ecosystemId], references: [id])

  @@unique([userId, ecosystemId, network])
  @@index([address])
  @@index([userId])
  @@map("deposit_addresses")
}

// 17 ─ WITHDRAWAL DESTINATION (new in Phase 1.5 review)
// Saved withdrawal addresses/bank accounts per user.
// Reduces re-entry errors and allows admin to flag novel vs known destinations.
model WithdrawalDestination {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  type        WithdrawalDestType
  network     Network?
  address     String             @db.VarChar(512)  // crypto address or IBAN
  label       String?            @db.VarChar(128)  // "My TON Wallet", "Norwegian Bank"
  isVerified  Boolean            @default(false)
  verifiedAt  DateTime?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, isActive])
  @@index([userId])
  @@map("withdrawal_destinations")
}
